GMAIL=your_email@gmail.com
APP_PASSWORD=your_app_password_here

# Flask sessiya/xavfsizlik uchun maxfiy kalit (production'da tasodifiy, uzun qiymat qo'ying)
SECRET_KEY=change_this_to_a_long_random_secret_value

# Admin akkaunt ma'lumotlari
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# 1 = debug rejimi yoqiq (faqat lokal ishlab chiqish uchun), 0 = production uchun xavfsiz
FLASK_DEBUG=0